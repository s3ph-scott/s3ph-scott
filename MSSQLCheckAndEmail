# MSSQL Check and Email
# Runs PSBlitz against remote SQL Server instances, creates an index HTML file to all reports for each instance, then emails the results to a nominated email address.

# Joseph Scott - joe@thescott.net

# Set a list of instances to check. We will move through these and perform the testing in a loop.
$instances = Get-Content $PSScriptRoot\instances.txt

# Would you like to send an email after the script finishes? Configure SMTP settings below.
$send_email = $false # $true or $false

# SMTP settings for use in passing to Powershell's Send-MailMessage function.
$smtp_server = ""
$smtp_port = "25"
$smtp_from = ""
$smtp_to = ""
$smtp_ssl = $false # $true or $false

# Use this if you really want to embed this in the script.
#$instances = ""

# Call the PSBlitz.ps1 script one by one.
Foreach($instance in $instances){

    # Build the output path then check this folder exists as the PSBlitz.ps1 script will simply ignore the OutputDir switch if it doensn't.
    $reportPath = $PSScriptRoot + "\Reports\" + $instance.replace('\','_')
    If(!(test-path -PathType Container $reportPath))
        {
            New-Item -ItemType Directory -Path $reportPath | Out-Null
        }
        # Clear out the folder where everything is stored as we don't want the old reports.
        else {
            Remove-Item -Path (Join-Path $reportPath '*') -Recurse -Force -ErrorAction Stop -Confirm:$false
        }

    # Call the PSBlitz script and pass some parameters into the call.
    & $PSScriptRoot\PSBlitz\PSBlitz.ps1 -ServerName $instance -OutputDir $reportPath -ToHTML
    
    # Move everything up a level, preserve the folder structure.
    $childFolder = Get-ChildItem -path $ReportPath -Directory | Sort-Object CreationTime -Descending | Select-Object -First 1

    if ($null -ne $childFolder){
        Get-ChildItem -Path $childFolder.FullName -Force | ForEach-Object{
            Move-Item -Path $_.FullName -Destination $ReportPath -Force
        }
        Remove-Item -Path $childFolder.FullName -Recurse -Force -Confirm:$false
    }
}
   
# Build an index.html file so that we can list all the reports that were made and also make it easy for someone to click into them.
$indexFile = $PSScriptRoot + "\Reports\index.html"

$reportInstances = foreach ($dir in Get-ChildItem -Path $PSScriptRoot\Reports -Directory){
    $indexPath = Get-ChildItem $dir.FullName -Filter 'PSBlitzOutput_*.html' -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1

    if ($null -ne $indexPath){
        [PSCustomObject]@{
            InstanceName = $dir.Name
            IndexPath = $indexPath
        }
    }
}

$rows = foreach ($entry in $reportInstances | Sort-Object InstanceName){
    "<tr>
        <td>$($entry.InstanceName)</td>
        <td><a href='$($entry.InstanceName)/$($entry.IndexPath)' target='_blank'>View Report</a></td>
    </tr>"
}

$html = @"
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>SQL Server Instances Blitz Report</title>
    <link rel="stylesheet" href="..\PSBlitz\Resources\styles.css">
	<script src="..\PSBlitz\Resources\dark-mode.js"></script>
</head>
<body>
<div class="toggle-wrapper">
<button id="dark-mode-toggle" type="button" aria-pressed="false">Dark</button>
<p>Generated on $(Get-Date -Format 'dd-MM-yyyy HH:mm')</p>
<table>
    <tr>
        <th>Instance</th>
        <th>Report</th>
        $(($rows -join "`r`n"))
</table>
</body>
</html>
"@

# Output the HTML file.
$html | Set-Content -Path $indexFile -Encoding UTF8

# Email the results if the send_email setting is true.
if ($send_email){
    $hostname = $env:COMPUTERNAME
    Send-MailMessage -Subject "Daily SQL Server PSBlitz Check $hostname" -To $smtp_to -From $smtp_from -ServerName $smtp_server -Port $smtp_port -UseSsl $smtp_ssl
}
